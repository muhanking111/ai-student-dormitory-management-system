MYSQL_DATABASE=student_dormitory
MYSQL_USER=dormitory_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

DB_URL=jdbc:mysql://localhost:3306/student_dormitory?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=dormitory_app
DB_PASSWORD=replace-with-a-local-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEMO_DATA_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 本地 HTTP 保持 false；生产 HTTPS 必须设为 true。
SESSION_COOKIE_SECURE=false
# 生产要求可信 Origin/Referer 才能提交首次登录；本地 dev profile 会显式关闭。
REQUIRE_LOGIN_ORIGIN=true

# 登录账号/IP 共享窗口限流。生产不得关闭；本地 dev/test profile 会显式关闭。
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_KEY_PREFIX=dormitory:auth:login:v1
LOGIN_RATE_LIMIT_USERNAME_ATTEMPTS=8
LOGIN_RATE_LIMIT_IP_ATTEMPTS=40
LOGIN_RATE_LIMIT_WINDOW=PT1M

# AI 控制面默认全部关闭。fake 仅允许 dev/test profile 显式启用。
AI_ENABLED=false
AI_CAPABILITY_ASSISTANT_ENABLED=false
AI_CAPABILITY_KNOWLEDGE_ENABLED=false
AI_CAPABILITY_DASHBOARD_ENABLED=false
AI_CAPABILITY_REPAIR_ENABLED=false
AI_CAPABILITY_NOTICE_ENABLED=false
AI_CAPABILITY_RISK_ENABLED=false
AI_CAPABILITY_EVALUATION_ENABLED=false
AI_PROVIDER_ACTIVE=none
AI_STREAMING_ENABLED=false
AI_WRITE_EXECUTION_ENABLED=false
AI_EXECUTION_LEASE_TIMEOUT=PT5M
AI_EXECUTION_RECOVERY_INTERVAL=PT1M

# 仅从环境或 Secret Manager 注入；不要把真实值提交到仓库。
AI_MODEL_BASE_URL=
AI_MODEL_NAME=
AI_PROVIDER_MODEL_ALIAS=
# 首发真实 provider 使用 DeepSeek；通用 AI_MODEL_* 可在部署平台统一覆盖。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
AI_ROLLOUT_ENABLED=false
AI_ROLLOUT_BASIS_POINTS=0
AI_ROLLOUT_POLICY_VERSION=rollout-disabled-v1
AI_ROLLOUT_HMAC_KEY=
AI_ROLLOUT_INTERNAL_USER_IDS=
AI_MODEL_API_KEY=
# 逗号分隔的获批 HTTPS base URL；生产激活 provider 时必须精确命中。
AI_PROVIDER_ENDPOINT_ALLOWLIST=
AI_EMBEDDING_API_KEY=
AI_AUDIT_HMAC_KEY=
AI_AUDIT_HMAC_ACTIVE_VERSION=1
# 仅在审计链密钥轮换宽限期内保留上一版本，否则旧事件将无法验证。
AI_AUDIT_PREVIOUS_HMAC_KEY=
AI_AUDIT_PREVIOUS_HMAC_VERSION=0
# 生产审计外锚；真实服务合同未运行时保持 disabled，禁止使用 fake 作为生产证据。
AI_AUDIT_ANCHOR_ENABLED=false
AI_AUDIT_ANCHOR_SINK=none
AI_AUDIT_ANCHOR_ENDPOINT=
AI_AUDIT_ANCHOR_ENDPOINT_ALLOWLIST=
AI_AUDIT_ANCHOR_HMAC_KEY=
AI_AUDIT_ANCHOR_TIMEOUT=PT5S
AI_TOKENIZATION_HMAC_KEY=
AI_TOKENIZATION_HMAC_ACTIVE_VERSION=1
AI_STEP_UP_HMAC_KEY=
AI_STEP_UP_HMAC_ACTIVE_VERSION=1
# 仅在轮换宽限期内配置上一版本；过窗后清空。
AI_STEP_UP_PREVIOUS_HMAC_KEY=
AI_STEP_UP_PREVIOUS_HMAC_VERSION=0
AI_STEP_UP_PROOF_TTL=PT5M
AI_STEP_UP_FAILURE_WINDOW=PT15M
AI_STEP_UP_MAX_FAILURES=5

# 风险规则建议初始值；修改会形成新的 policyVersion，生产调整需走业务校准。
AI_RISK_REPAIR_BACKLOG_HOURS=72
AI_RISK_REPEAT_REPAIR_COUNT=3
AI_RISK_REPEAT_REPAIR_WINDOW_DAYS=30
AI_RISK_LONG_PENDING_HOURS=48

# 预算、SSE 与执行器边界。
AI_RUN_RESERVED_TOKENS=20000
AI_RUN_RESERVED_COST=0
AI_BUDGET_RESERVATION_TTL=PT10M
AI_EXECUTOR_CORE_SIZE=2
AI_EXECUTOR_MAX_SIZE=4
AI_EXECUTOR_QUEUE_CAPACITY=256
AI_MAX_SSE_CONNECTIONS_PER_USER=3
AI_SSE_HEARTBEAT_INTERVAL=PT15S
AI_SSE_EMITTER_TIMEOUT=PT5M

# Redis Lua burst 限流。生产不得关闭；阈值是安全计划建议初始值，需按真实流量校准。
AI_RATE_LIMIT_ENABLED=true
AI_REDIS_KEY_PREFIX=dormitory:ai
AI_RUNS_PER_MINUTE=10
AI_UPLOADS_PER_HOUR=20
AI_INGESTIONS_PER_HOUR=20
AI_RISK_SCANS_PER_MINUTE=5
AI_APPROVALS_PER_MINUTE=10
AI_APPROVALS_PER_PROPOSAL_PER_MINUTE=5
AI_WRITES_PER_MINUTE=60
AI_RATE_LIMIT_IP_MULTIPLIER=5

# 生产填写可审计的 Secret Manager provider/code 与 KMS key reference；空值会触发启动门拒绝。
AI_SECRET_MANAGER_PROVIDER=
AI_KMS_KEY_REFERENCE=
# 以下布尔确认位仅在 prod 完成真实验证后设为 true；配置值不能替代网络和备份证据。
AI_REDIS_PRIVATE_NETWORK_CONFIRMED=false
AI_BACKUP_ENCRYPTION_CONFIRMED=false
